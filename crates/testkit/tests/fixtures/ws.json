{
  "runs": {
    "main": {
      "steps": [
        {
          "id": "connect-a",
          "connect": {
            "client": "A",
            "request": { "head": "GET /ws HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n" },
            "handshake": {
              "statusLine": "HTTP/1.1 101 Switching Protocols",
              "headers": [["Upgrade", "websocket"], ["Connection", "Upgrade"], ["Sec-WebSocket-Accept", "s3pPLMBiTxaQ9kYGzzhZRbK+xO="]]
            }
          },
          "frames": { "A": [ { "type": "text", "text": "{\"type\":\"snapshot\",\"v\":1,\"sessions\":[]}" } ] }
        },
        {
          "id": "post-event",
          "http": {
            "request": { "head": "POST /event HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\nContent-Length: 2\r\n\r\n", "body": "{}" },
            "response": {
              "statusLine": "HTTP/1.1 200 OK",
              "headers": [["Content-Type", "application/json"]],
              "body": "{\"ok\":true}"
            }
          },
          "frames": { "A": [ { "type": "text", "text": "{\"type\":\"message.user\",\"v\":1,\"ts\":1760000001000}" } ] }
        },
        {
          "id": "upgrade-denied",
          "connect": {
            "client": "X1",
            "request": { "head": "GET /ws HTTP/1.1\r\nHost: evil.example\r\nUpgrade: websocket\r\n\r\n" },
            "handshake": {
              "statusLine": "HTTP/1.1 403 Forbidden",
              "headers": [["Connection", "close"], ["Content-Length", "0"]],
              "body": "",
              "serverClosed": true
            }
          },
          "frames": {}
        },
        {
          "id": "term-echo",
          "connect": {
            "client": "A",
            "request": { "head": "GET /term?id=pty-0a1b2c3d HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n" },
            "handshake": {
              "statusLine": "HTTP/1.1 101 Switching Protocols",
              "headers": [["Upgrade", "websocket"], ["Connection", "Upgrade"], ["Sec-WebSocket-Accept", "s3pPLMBiTxaQ9kYGzzhZRbK+xO="]]
            }
          },
          "sent": [
            { "client": "A", "type": "text", "text": "{\"type\":\"resize\",\"cols\":80,\"rows\":24}" },
            { "client": "A", "type": "binary", "hex": "6563686f0d" }
          ],
          "sentClose": { "client": "A", "code": 1000 },
          "frames": {
            "A": [
              { "type": "binary", "text": "echo\r\n", "replay": true },
              { "type": "close", "code": 1000, "reason": "" },
              { "type": "tcp-closed" }
            ]
          }
        }
      ]
    }
  }
}
