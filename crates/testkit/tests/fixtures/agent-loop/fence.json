    {"name": "outside", "tool": "file_read", "args": {"path": "/etc/passwd"}, "outcome": "block"},
    {"name": "shared-prefix sibling", "tool": "file_read", "args": {"path": "/work/acme-evil/x"}, "outcome": "block"},
    {"name": "dot-dot escape", "tool": "file_write", "args": {"path": "/work/acme/../secrets"}, "outcome": "block"},
    {"name": "symlink out", "tool": "file_read", "args": {"path": "/work/acme/link-to-etc/passwd"}, "symlink": {"/work/acme/link-to-etc": "/etc"}, "outcome": "block"},
    {"name": "wrong type", "tool": "file_read", "args": {"path": 5}, "outcome": "block"},
