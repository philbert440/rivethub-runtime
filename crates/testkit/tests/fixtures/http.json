{
  "runs": {
    "main": {
      "cases": [
        {
          "id": "healthz-get",
          "request": {
            "via": "loopback (source 127.0.0.1)",
            "head": "GET /healthz HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\n\r\n"
          },
          "response": {
            "statusLine": "HTTP/1.1 200 OK",
            "headers": [["Content-Type", "application/json"], ["Date", "{{DATE}}"], ["Transfer-Encoding", "chunked"]],
            "body": "{\"ok\":true,\"sessions\":0,\"name\":\"{{HOSTNAME}}\"}"
          }
        },
        {
          "id": "static-png",
          "request": { "head": "GET /pixel.png HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\n\r\n" },
          "response": {
            "statusLine": "HTTP/1.1 200 OK",
            "headers": [["Content-Type", "image/png"]],
            "bodyBase64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
          }
        },
        {
          "id": "deviation-server-header",
          "request": { "head": "GET /healthz HTTP/1.1\r\nHost: 127.0.0.1:{{PORT}}\r\n\r\n" },
          "response": {
            "statusLine": "HTTP/1.1 200 OK",
            "headers": [["Content-Type", "application/json"], ["X-Recorded-Only", "yes"]],
            "body": "{\"ok\":true,\"sessions\":0,\"name\":\"gold-host\"}"
          }
        }
      ]
    }
  }
}
