{
  "default": "echo",
  "cwd": "/roster-fixture/top",
  "env": {
    "ACME_ROSTER_ENV": "roster",
    "SHARED": "top",
    "PATH": "/usr/bin"
  },
  "commands": {
    "claude": {
      "label": "Claude Code",
      "cmd": ["node", "claude.js"],
      "room": true
    },
    "echo": {
      "label": "Acme Echo",
      "cmd": ["echo", "hi"],
      "room": true
    },
    "envdump": {
      "label": "Acme Env",
      "cmd": ["/bin/sh", "-c", "printf done"],
      "room": false,
      "cwd": "/roster-fixture/entry",
      "env": {
        "ACME_ENTRY_ENV": "envdump",
        "SHARED": "entry",
        "RIVETOS_USER_ID": "from-roster",
        "RIVETOS_USER_DBS": "denied"
      }
    },
    "shell": {
      "label": "Shell",
      "cmd": ["bash", "-l"],
      "room": false,
      "env": {
        "ACME_ENTRY_ENV": "shell"
      }
    },
    "silent": {
      "label": "Acme Silent",
      "cmd": ["/bin/true"]
    }
  }
}
