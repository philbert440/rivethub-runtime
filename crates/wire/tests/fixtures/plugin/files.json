{
  "manifests": [
    {
      "manifest": 1,
      "id": "files",
      "name": "Files",
      "version": "0.1.0",
      "description": "Browse, preview and manage the node's files.",
      "icon": "folder",
      "run": {
        "command": [
          "./target/release/rivethub-files"
        ]
      },
      "permissions": [
        "host.files.read",
        "host.files.write"
      ],
      "settings": [
        {
          "key": "root",
          "label": "Root folder",
          "input": {
            "type": "text"
          },
          "value": "/home/user",
          "required": true
        },
        {
          "key": "showHidden",
          "label": "Show hidden files",
          "input": {
            "type": "toggle"
          }
        }
      ],
      "contributes": {
        "pages": [
          {
            "id": "files",
            "title": "Files",
            "icon": "folder",
            "view": "browse"
          }
        ],
        "sessionActions": [
          {
            "id": "open-cwd",
            "title": "Browse this session's folder",
            "icon": "folder_open",
            "action": {
              "type": "call",
              "action": "open-session-folder"
            }
          }
        ]
      }
    }
  ],
