{
  "manifests": [
    {
      "$schema": "https://example.com/rivethub-plugin.schema.json",
      "manifest": 1,
      "id": "workflows",
      "name": "Workflows",
      "version": "0.1.0",
      "description": "Multi-step agent workflows with a graph editor and run history.",
      "icon": "account_tree",
      "run": {
        "command": [
          "node",
          "dist/main.js"
        ],
        "env": {
          "NODE_ENV": "production"
        },
        "readyTimeoutMs": 15000
      },
      "permissions": [
        "sessions.read",
        "sessions.control",
        "tasks.read",
        "tasks.delegate",
        "agents.read",
        "memory.read",
        "memory.write",
        "notifications.send"
      ],
      "settings": [
        {
          "key": "maxParallelRuns",
          "label": "Runs at once",
          "input": {
            "type": "number",
            "min": 1,
            "max": 8,
            "step": 1
          },
          "value": 2,
          "required": true
        },
        {
          "key": "notifyOnFinish",
          "label": "Notify when a run finishes",
          "input": {
            "type": "toggle"
          },
          "value": true
        },
        {
          "key": "defaultAgent",
          "label": "Default agent",
          "input": {
            "type": "text"
          },
          "placeholder": "claude-code",
          "help": "Used by steps that name no agent."
        },
        {
          "key": "webhookSecret",
          "label": "Webhook secret",
          "input": {
            "type": "secret"
          }
        }
      ],
      "tools": [
        {
          "name": "start_run",
          "title": "Start a workflow run",
          "description": "Start a run of a saved workflow and answer its run id.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "string"
              },
              "inputs": {
                "type": "object"
              }
            },
            "required": [
              "workflow"
            ]
          }
        },
        {
          "name": "run_status",
          "description": "Report the status and step results of a workflow run.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string"
              }
            },
            "required": [
              "runId"
            ]
          },
          "hints": [
            "readOnly",
            "idempotent"
          ]
        }
      ],
      "contributes": {
        "pages": [
          {
            "id": "workflows",
            "title": "Workflows",
            "icon": "account_tree",
            "view": "workflows"
          }
        ],
        "topicCards": [
          {
            "id": "topic-runs",
            "title": "Workflow runs",
            "view": "topic-runs"
          }
        ],
        "sessionActions": [
          {
            "id": "run-on-session",
            "title": "Run a workflow on this session",
            "icon": "play_arrow",
            "action": {
              "type": "dialog",
              "view": "start-run"
            }
          }
        ]
      },
      "jobs": [
        {
          "id": "prune-runs",
          "title": "Prune old runs",
          "schedule": "0 3 * * *",
          "timeoutMs": 60000
        },
        {
          "id": "nightly-review",
          "title": "Nightly review",
          "schedule": "0 2 * * *"
        }
      ],
      "events": [
        "session.idle",
        "session.ended",
        "summary.written",
        "task.done"
      ]
    }
  ],
  "views": [
    {
      "title": "Workflows",
      "subtitle": "2 saved",
      "toolbar": [
        {
          "label": "New workflow",
          "icon": "add",
          "style": "primary",
          "action": {
            "type": "dialog",
            "view": "new-workflow"
