  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.slug, t.name, t.parent_id, t.directory_kind, t.directory_node,\n                t.directory_path, t.created_at, t.updated_at\n           FROM rh_topics t\n          WHERE t.slug = $1\n             OR t.id = (SELECT r.topic_id FROM rh_topic_redirects r WHERE r.slug = $1)\n          ORDER BY (t.slug = $1) DESC\n          LIMIT 1",
