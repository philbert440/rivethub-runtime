  "query": "insert into rh_tags (entity_type, entity_id, key, value, display, source, state, proposed_by, reason, decided_by, decided_at) values ($1, $2, $3, $4, coalesce($5, ''), 'user', 'accepted', '', coalesce($6, ''), $7::text, case when $7::text is null then null else now() end) on conflict (entity_type, entity_id, key, value) do update set state = 'accepted', decided_by = coalesce($7::text, rh_tags.decided_by), decided_at = case when $7::text is null then rh_tags.decided_at else now() end, updated_at = now() returning id::text as \"id!\", entity_type, entity_id::text as \"entity_id!\", key, value, display, source, state, confidence, proposed_by, reason, decided_by, decided_at, created_at, updated_at",
